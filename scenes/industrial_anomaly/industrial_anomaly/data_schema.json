{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-edge.local/schemas/examples/industrial-anomaly-map-v1.json",
  "title": "Industrial RGB or infrared anomaly result",
  "type": "object",
  "required": ["sample_id", "modality", "score", "raw_uri", "heatmap_uri"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "product": {
      "enum": [
        "button_cell", "capsule", "cotton", "cube", "piggy",
        "plastic_cylinder", "screw", "solar_panel", "toothbrush", "zipper"
      ]
    },
    "modality": {"enum": ["rgb", "infra", "infrared", "RGB", "Infrared"]},
    "score": {"type": "number", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "raw_uri": {"type": "string", "pattern": "^(file|https?)://", "maxLength": 4096},
    "heatmap_uri": {"type": "string", "pattern": "^(file|https?)://", "maxLength": 4096},
    "heatmap_size_bytes": {"type": "integer", "minimum": 0},
    "heatmap_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "asset_id": {"type": ["string", "integer"]},
    "region_id": {"type": ["string", "integer"]},
    "threshold": {"type": ["string", "number"]},
    "proposed_limit_percent": {"type": ["string", "number"]},
    "shared_resource": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      ]
    },
    "inference_ms": {"type": "number", "minimum": 0},
    "preprocessing_latency_ms": {"type": "number", "minimum": 0},
    "deadline_ms": {"type": "number", "exclusiveMinimum": 0},
    "model": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
