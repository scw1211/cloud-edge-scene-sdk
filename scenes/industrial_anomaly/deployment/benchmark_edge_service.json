{
  "schema_version": 1,
  "role": "edge",
  "plugin_config": "scenes/industrial_anomaly/deployment/benchmark_scene_plugins_edge.json",
  "listen": {
    "host": "127.0.0.1",
    "port": 19501,
    "max_body_bytes": 8388608,
    "access_log": false
  },
  "storage": {
    "outbox": "runtime/industrial_selective_compact_20260812/edge_outbox.sqlite3",
    "performance_profiles": "runtime/industrial_selective_compact_20260812/edge_performance.json",
    "feedback": "runtime/industrial_selective_compact_20260812/edge_feedback.jsonl",
    "idempotency": "runtime/industrial_selective_compact_20260812/edge_idempotency.sqlite3",
    "reviews": "runtime/industrial_selective_compact_20260812/edge_reviews.sqlite3",
    "monitoring": "runtime/industrial_selective_compact_20260812/edge_monitoring.sqlite3"
  },
  "scheduler": {"confidence_threshold": 0.75, "jitter_guard": 1.645},
  "cloud": {
    "base_url": "http://127.0.0.1:19510",
    "timeout_seconds": 0.25,
    "max_attempts": 1,
    "retry_backoff_seconds": 0.01
  },
  "release_watch": {
    "enabled": false,
    "registry": "scenes/freeway_traffic/runtime/edge_llm_release_store.json",
    "interval_seconds": 2.0
  },
  "network_probe": {
    "interval_seconds": 0.2,
    "window_size": 10,
    "failure_threshold": 2,
    "uplink_mbps": 100.0,
    "downlink_mbps": 100.0,
    "expected_response_bytes": 4096,
    "cloud_queue_ms": 1.0,
    "cloud_compute_ms": 1.0
  },
  "replay": {
    "interval_seconds": 0.05,
    "batch_size": 64,
    "lease_seconds": 2.0,
    "max_backoff_seconds": 0.5,
    "batch_coalesce_seconds": 0.0,
    "waiting_poll_seconds": 0.02,
    "partial_poll_seconds": 0.03,
    "aggregation_max_wait_seconds": 5.0,
    "aggregation_batch_wait_seconds": 0.0,
    "reconciliation_poll_seconds": 0.05,
    "reconciliation_max_wait_seconds": 10.0
  },
  "idempotency": {"ttl_seconds": 86400, "max_entries": 100000}
}
