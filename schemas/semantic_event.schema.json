{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/semantic_event.schema.json",
  "title": "Cloud-edge semantic event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "scene",
    "task",
    "edge_id",
    "occurred_at_ms",
    "scope",
    "prediction",
    "risk",
    "uncertainty",
    "timing",
    "evidence",
    "candidate_actions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "scene": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "edge_id": {"type": "string", "minLength": 1},
    "occurred_at_ms": {"type": "integer", "minimum": 0},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "subsystem", "state_variable", "region_id", "window_start_ms", "window_end_ms"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "subsystem": {"type": "string", "minLength": 1},
        "state_variable": {"type": "string", "minLength": 1},
        "region_id": {"type": "string", "minLength": 1},
        "shared_resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "correlation_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "window_start_ms": {"type": "integer", "minimum": 0},
        "window_end_ms": {"type": "integer", "minimum": 0}
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "values": {"type": "object"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "severe"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "calibrated", "prediction_set", "method"],
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "calibrated": {"type": "boolean"},
        "prediction_set": {"type": "array", "items": {"enum": ["low", "medium", "high", "severe"]}, "uniqueItems": true},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_ms", "preprocessing_ms", "edge_inference_ms"],
      "properties": {
        "deadline_ms": {"type": "number", "exclusiveMinimum": 0},
        "preprocessing_ms": {"type": "number", "minimum": 0},
        "edge_inference_ms": {"type": "number", "minimum": 0}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "level", "modality", "encoding", "size_bytes", "content_type"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "level": {"enum": ["summary", "feature", "raw"]},
          "modality": {"type": "string", "minLength": 1},
          "encoding": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "inline": {},
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_type": {"type": "string", "minLength": 1},
          "codec": {"type": "object"}
        },
        "anyOf": [{"required": ["uri"]}, {"required": ["inline"]}]
      }
    },
    "candidate_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "model": {"type": "object"},
    "scene_payload": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_ids", "resource_ids", "parameters", "reason", "priority"],
      "properties": {
        "action_type": {"type": "string", "minLength": 1},
        "target_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "resource_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "parameters": {"type": "object"},
        "reason": {"type": "string"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
