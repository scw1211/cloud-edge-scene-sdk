{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/edge_llm_pipeline.schema.json",
  "title": "Edge LLM Distillation Pipeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_id", "state_path", "stages"],
  "properties": {
    "schema_version": {"const": "edge-llm-pipeline/v1"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "state_path": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["verify_base", "command", "select_candidate", "build_adapter", "validate_adapter", "publish_release"]
          },
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "argv": {"type": "array", "items": {"type": "string"}},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}},
          "registry": {"type": "string", "minLength": 1},
          "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"},
          "base": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "deployment_artifact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
