{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-edge.local/schemas/weak-network-experiment-plan-v1.json",
  "title": "交通弱网业务保持率预注册实验计划",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "scene",
    "git_commit",
    "dataset_id",
    "model_ids",
    "hardware_id",
    "seed",
    "profile_order",
    "fault_profiles",
    "sample_ids_by_profile",
    "business_deadline_ms",
    "aggregation_timeout_ms",
    "dispatch_lead_ms",
    "split",
    "top_k"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "scene": {"const": "freeway_traffic"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "model_ids": {"type": "object", "minProperties": 1},
    "hardware_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "profile_order": {
      "const": ["normal", "mild", "severe", "outage", "recovery"]
    },
    "fault_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "mild", "severe", "outage"],
      "properties": {
        "normal": {"$ref": "#/$defs/faultProfile"},
        "mild": {"$ref": "#/$defs/faultProfile"},
        "severe": {"$ref": "#/$defs/faultProfile"},
        "outage": {"$ref": "#/$defs/faultProfile"}
      }
    },
    "sample_ids_by_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "mild", "severe", "outage"],
      "properties": {
        "normal": {"$ref": "#/$defs/sampleIds"},
        "mild": {"$ref": "#/$defs/sampleIds"},
        "severe": {"$ref": "#/$defs/sampleIds"},
        "outage": {"$ref": "#/$defs/sampleIds"}
      }
    },
    "business_deadline_ms": {"type": "number", "exclusiveMinimum": 0},
    "aggregation_timeout_ms": {"type": "integer", "minimum": 1},
    "dispatch_lead_ms": {"type": "number", "minimum": 0},
    "split": {"enum": ["train", "val", "test"]},
    "top_k": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "faultProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay_ms", "jitter_ms", "loss_rate"],
      "properties": {
        "delay_ms": {"type": "number", "minimum": 0},
        "jitter_ms": {"type": "number", "minimum": 0},
        "loss_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sampleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    }
  }
}
