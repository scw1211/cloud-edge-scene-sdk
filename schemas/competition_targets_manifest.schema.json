{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-edge.local/schemas/competition-targets-manifest-v1.json",
  "title": "交通场景七项统一证据门禁清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "scene",
    "industrial_excluded",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "scene": {"const": "freeway_traffic"},
    "industrial_excluded": {"const": true},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_retention",
        "ttft_reduction",
        "single_inference_memory",
        "weak_network_retention",
        "weighted_business_e2e",
        "traffic_global_objective",
        "model_update_loop"
      ],
      "properties": {
        "capability_retention": {"$ref": "#/$defs/basicTarget"},
        "ttft_reduction": {"$ref": "#/$defs/basicTarget"},
        "single_inference_memory": {"$ref": "#/$defs/basicTarget"},
        "weak_network_retention": {
          "allOf": [
            {"$ref": "#/$defs/basicTarget"},
            {
              "type": "object",
              "required": ["experiment_plan"],
              "properties": {
                "experiment_plan": {"$ref": "#/$defs/fileRef"}
              }
            }
          ]
        },
        "weighted_business_e2e": {
          "allOf": [
            {"$ref": "#/$defs/basicTarget"},
            {
              "type": "object",
              "required": ["weight_plan"],
              "properties": {"weight_plan": {"$ref": "#/$defs/fileRef"}}
            }
          ]
        },
        "traffic_global_objective": {
          "allOf": [
            {"$ref": "#/$defs/basicTarget"},
            {
              "type": "object",
              "required": ["objective_definition", "sample_plan"],
              "properties": {
                "objective_definition": {"$ref": "#/$defs/fileRef"},
                "sample_plan": {"$ref": "#/$defs/fileRef"}
              }
            }
          ]
        },
        "model_update_loop": {
          "allOf": [
            {"$ref": "#/$defs/basicTarget"},
            {
              "type": "object",
              "required": [
                "stage_evidence",
                "completion_marker",
                "distributed_evidence",
                "distributed_completion_marker"
              ],
              "properties": {
                "completion_marker": {"$ref": "#/$defs/fileRef"},
                "distributed_evidence": {"$ref": "#/$defs/fileRef"},
                "distributed_completion_marker": {"$ref": "#/$defs/fileRef"},
                "expected": {
                  "type": "object",
                  "required": ["llama_server_sha256"]
                },
                "stage_evidence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["package", "release", "apply", "rollback"],
                  "properties": {
                    "package": {"$ref": "#/$defs/fileRef"},
                    "release": {"$ref": "#/$defs/fileRef"},
                    "apply": {"$ref": "#/$defs/fileRef"},
                    "rollback": {"$ref": "#/$defs/fileRef"}
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "expectedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "dataset_id",
        "model_ids",
        "hardware_id",
        "metric_semantics"
      ],
      "properties": {
        "git_commit": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "model_ids": {},
        "hardware_id": {},
        "metric_semantics": {"type": "string", "minLength": 1},
        "llama_server_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "basicTarget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evidence", "expected"],
      "properties": {
        "evidence": {"$ref": "#/$defs/fileRef"},
        "expected": {"$ref": "#/$defs/expectedContext"},
        "criteria": {"type": "object"}
      }
    }
  }
}
