{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-edge.local/schemas/examples/industrial-anomaly-map-v1.json",
  "title": "Industrial anomaly detector output",
  "type": "object",
  "required": [
    "asset_id",
    "subsystem",
    "region_id",
    "anomaly_score",
    "threshold",
    "heatmap",
    "shared_resource",
    "proposed_limit_percent"
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "subsystem": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "anomaly_score": {"type": "number", "minimum": 0, "maximum": 1},
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "calibrated": {"type": "boolean"},
    "confidence_method": {"type": "string", "minLength": 1},
    "window_ms": {"type": "integer", "minimum": 1},
    "deadline_ms": {"type": "number", "exclusiveMinimum": 0},
    "preprocessing_latency_ms": {"type": "number", "minimum": 0},
    "inference_latency_ms": {"type": "number", "minimum": 0},
    "shared_resource": {"type": "string", "minLength": 1},
    "proposed_limit_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "model": {"type": "object"},
    "heatmap": {
      "type": "object",
      "required": ["uri", "encoding", "shape", "size_bytes"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "encoding": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2
        },
        "size_bytes": {"type": "integer", "minimum": 1},
        "content_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
